{
  "manifest_version": 3,
  "name": "Native Browser Lens",
  "description": "Local browser evidence for the Native Browser Lens notebook on macOS and Linux.",
  "version": "0.10.3",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/lens-16.png",
    "32": "icons/lens-32.png",
    "48": "icons/lens-48.png",
    "128": "icons/lens-128.png"
  },
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "icons/lens-16.png",
      "32": "icons/lens-32.png"
    },
    "default_title": "Native Browser Lens \u2014 capture observation"
  },
  "commands": {
    "capture-observation": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "MacCtrl+Shift+L"
      },
      "description": "Capture an observation before opening the notebook"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'none'"
  },
  "key": ""
}
